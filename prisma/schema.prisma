generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma/client"
  // moduleFormat           = "esm"
  // generatedFileExtension = "ts"
  // importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"

}

model Product {
  id           String     @id @default(uuid())
  name        String
  company     String
  description String
  featured   Boolean
  // A URL path which is going to lead back to our superbase instance
  image       String
  price       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // A value we are going to get from our authentication provider the sevice by the name of Clerk
  // This will be the admin user ID
  clerkId  String
  // This is going to reference our Favourite model
  // Each product is going to have an array of favourites
  // Everytime we create the favourite, we pick the product & that is going to be added to this array
  // Since we have this relationship in place, we fetch tghe favourites, we will also be able to access the info on a product.
  // 
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(uuid())
  clerkId  String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}